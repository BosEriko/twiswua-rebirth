{
  "rules": {
    ".read": false,
    ".write": false,
    "survival": {
      "rooms": {
        "$room": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid && newData.child('members').numChildren() === 1 && newData.child('members').child(auth.uid).exists() && newData.child('state/world/phase').val() === 'ready') || (data.child('host').val() === auth.uid && !newData.exists()))",
          ".validate": "$room.matches(/^[A-HJ-NP-Z2-9]{8}$/) && newData.hasChildren(['host', 'createdAt', 'members', 'state'])",
          "host": {
            ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
          },
          "members": {
            ".validate": "newData.numChildren() <= 4",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('survival/rooms').child($room).exists() && (!newData.exists() || data.exists() || root.child('survival/rooms').child($room).child('state/world/phase').val() === 'ready')",
              ".validate": "newData.hasChildren(['name', 'input'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
              },
              "input": {
                ".validate": "newData.hasChildren(['x', 'y', 'joystick', 'dash', 'roar', 'upgradeWave', 'upgradeRound'])",
                "x": {
                  ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 1000"
                },
                "y": {
                  ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 1000"
                },
                "dash": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
                },
                "roar": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
                },
                "upgradeWave": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
                },
                "joystick": {
                  ".validate": "newData.isBoolean()"
                },
                "upgrade": {
                  ".validate": "newData.val() === '' || newData.val() === 'claws' || newData.val() === 'haste' || newData.val() === 'heart' || newData.val() === 'reach' || newData.val() === 'armor' || newData.val() === 'recovery' || newData.val() === 'dash' || newData.val() === 'roar'"
                },
                "$other": {
                  ".validate": false
                },
                "upgradeRound": {
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                }
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "state": {
            ".write": "auth != null && root.child('survival/rooms').child($room).child('host').val() === auth.uid",
            ".validate": "newData.hasChildren(['world', 'players', 'consumed'])",
            "world": {
              ".validate": "newData.hasChildren(['phase', 'wave', 'time', 'kills']) && (newData.child('phase').val() === 'ready' || newData.child('phase').val() === 'playing' || newData.child('phase').val() === 'upgrade' || newData.child('phase').val() === 'over')"
            },
            "players": {
              ".validate": "newData.numChildren() <= 4"
            },
            "consumed": {
              ".validate": "newData.numChildren() <= 4"
            },
            "$other": {
              ".validate": false
            },
            "round": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
